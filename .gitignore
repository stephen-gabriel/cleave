# Hardhat
artifacts
cache

# Throwaway deployer key. Never commit.
.env.deployer

# Local env. Holds only public values today (RPC URL, deployer address, contract
# address), but is untracked so a future secret cannot leak by accident. Vite
# reads it locally; Vercel must define these in project settings instead.
.env
.env.*
!.env.example

